{
  "$schema": "../../schemas/csweet-plugin.v2.schema.json",
  "manifestVersion": "2.0",
  "kind": "agent",
  "id": "com.csweet.sample.hello",
  "name": "C-Sweet Hello Agent",
  "version": "0.1.0",
  "publisher": { "id": "com.csweet", "name": "C-Sweet" },
  "runtime": {
    "type": "dotnet-project",
    "projectPath": "src/HelloAgent/HelloAgent.csproj",
    "targetFramework": "net10.0",
    "defaultActivationMode": "OnDemand",
    "supportsMultipleInstallations": true,
    "maximumConcurrentJobs": 1
  },
  "protocol": { "minimumVersion": "2.0", "maximumVersion": "2.x" },
  "provides": [
    {
      "name": "hello.say.v1",
      "description": "Return a greeting for a supplied name.",
      "inputSchema": {
        "type": "object",
        "properties": { "name": { "type": "string", "minLength": 1 } },
        "required": ["name"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": { "message": { "type": "string" } },
        "required": ["message"],
        "additionalProperties": false
      },
      "executionTimeoutSeconds": 30,
      "idempotency": "work-item",
      "riskClass": "standard"
    }
  ],
  "requires": [],
  "events": { "subscribes": [] },
  "configuration": [],
  "credentials": [],
  "webAccess": { "mode": "None", "rules": [] },
  "ui": [],
  "catalog": {
    "summary": "Returns a friendly greeting.",
    "category": "Sample",
    "role": { "key": "greeter", "name": "Greeter" },
    "license": { "spdxId": "MIT" },
    "iconUrls": [],
    "roleAliases": [],
    "keywords": ["sample", "hello"],
    "documentationUrl": "README.md"
  }
}
